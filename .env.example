# =============================================================================
# ihealth-relay 環境変数サンプル
# 使い方: cp .env.example .env してから各値を書き換える (chmod 600 .env 推奨)
#
# - `#` で始まる行はコメント。コメントアウトしたキー / 値が空のキーは既定値で動く
# - この値はプロセスの環境変数にはならない (ihealth-relay が .env を直接読む)
# - 実際の .env には使うキーだけを残す (誤コミット時の漏洩範囲を小さくするため)
# =============================================================================

# --- publisher の既定 ---
# --publisher を省略したときに使う publisher。未設定なら notion (従来どおり)。
# 許可値: notion / markdown / stdout / sqlite / slack / dryrun / obsidian
# launchd (bin/install-launchd.sh) は引数なしで起動するので、Obsidian 日記を
# 自動更新するならここを obsidian にする。install-launchd.sh はこの値で起動時刻を
# 決める (obsidian = 07:00 / 12:00 / 21:00、それ以外 = 07:00)。変えたら再実行する。
#IHEALTH_PUBLISHER=obsidian

# --- Notion API (--publisher notion のときだけ必須) ---
# https://www.notion.so/my-integrations で作成したインテグレーションのシークレット
# (旧 GoogleFitNotionIntegration からそのまま引き継ぎ可能)
# obsidian / markdown / stdout / sqlite / slack / dryrun だけを使うなら空 or 削除してよい。
NOTION_SECRET=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion 日記 DB の ID (URL の末尾 32文字)
DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Health Auto Export (常に必須) ---
# Health Auto Export の iCloud Drive 領域。次のどちらかを指定する。
#
#   (a) AutoSync ディレクトリ (下の既定値): 直下に HealthMetrics/{metric}/{YYYYMMDD}.hae が並ぶ。
#       notion / markdown / stdout / sqlite / slack (AutoSync .hae だけを読む経路) はこちらが必須。
#       obsidian も動く (オートメーション JSON は親の Documents 以下から探す。
#       AutoSync を止めて HealthMetrics を消した後も同じ)。
#   (b) Documents ディレクトリ (AutoSync の親): obsidian 用。オートメーション JSON
#       (<オートメーション名>/HealthAutoExport-YYYY-MM-DD.json) を自動で探し、
#       Documents/AutoSync があれば .hae で欠けた値を補う。AutoSync を一度も使って
#       いない (AutoSync フォルダが無い) なら obsidian ではこちらを指定する。
#
# 先頭の `~/` はホームディレクトリに展開される。
# 中間の `~` (iCloud~com~ifunography~HealthExport) はフォルダ名の一部なので展開されない。
HEALTH_EXPORT_DIR=~/Library/Mobile Documents/iCloud~com~ifunography~HealthExport/Documents/AutoSync
#HEALTH_EXPORT_DIR=~/Library/Mobile Documents/iCloud~com~ifunography~HealthExport/Documents

# --- 個人プロファイル (運動強度スコア = Heart Points 算出に使用, 常に必須) ---
# 最大心拍数 = 205.8 - 0.685 × age (Tanaka 式)。誕生日から動的に age を算出。
# 下の値はダミーです。自分の誕生日に必ず書き換えてください。
BIRTH_DATE=1990-01-01

# --- ログ ---
# debug / info / warning / error
LOG_LEVEL=info

# =============================================================================
# Obsidian 日記 (--publisher obsidian / IHEALTH_PUBLISHER=obsidian)
#
# 健康 (Health Auto Export) + 気象庁の天気 + GitHub 活動を、日記ノート
# <vault>/<日記ディレクトリ>/**/YYYY-MM-DD.md の frontmatter に書く。
# 必須は OBSIDIAN_VAULT_DIR だけ。他は省略時にコメントの既定値で動く。
# frontmatter のキー名を変えたいときは config.toml の [publishers.obsidian] を使う。
# =============================================================================

# vault のルート (obsidian では必須)。~/... または絶対パス。
#OBSIDIAN_VAULT_DIR=~/obsidian/<vault>

# vault 内の日記ディレクトリ (vault からの相対パス。配下のサブフォルダも再帰的に探す)。
# 既定: 日記
#OBSIDIAN_DIARY_DIR=日記

# 日記ノートが無い日に使う Templater テンプレート (vault 相対 / ~/... / 絶対パス)。
# Templater を実行せずに展開できる範囲だけ対応する: 先頭の <%* ... %> ブロック (除去),
# <% dateStr %> (YYYY-MM-DD), <% weekday %> (月〜日)。他の <% が残るテンプレートは使わない。
# 未設定なら、ノートが無い日には書かない (ノートも作らない)。
#OBSIDIAN_TEMPLATE=Templates/Daily.md

# ノートが無い日の扱い: never (作らない) / template (テンプレートから作る) /
# minimal (テンプレートが使えなければ日付キーだけの最小ノートを作る)。
# 既定: OBSIDIAN_TEMPLATE があれば template、無ければ never。
# template を指定するなら OBSIDIAN_TEMPLATE も必要。
#OBSIDIAN_CREATE_MISSING=template

# ノートを新しく作ってよい日の下限 (今日 - 対象日 がこの日数以上の日だけ作る, 0〜366)。
# 既定 2 = 今日・昨日のノートは作らない (別の端末で作られた同じ日のノートと
# Obsidian Sync 上で衝突させないため)。0 にすると今日のノートも作る。
#OBSIDIAN_CREATE_MIN_AGE_DAYS=2

# --- 対象期間 / source ---
# 引数なしの実行 (launchd) で処理する過去の日数: 昨日から N 日分 (0〜366)。既定 7
#IHEALTH_LOOKBACK_DAYS=7
# 今日の暫定値も書くか (true / false)。既定 true。今日の値は後の実行で確定値に置き換わる
# (確定するまで data/diary-state.json で追跡し、引数なしの実行が 30 日まで処理し直す)
#IHEALTH_INCLUDE_TODAY=true
# 処理する source (health,weather,github から選ぶ。カンマ区切り)。既定は 3 つ全部
#IHEALTH_SOURCES=health,weather,github
# 日記の基準タイムゾーン (UTC オフセット: +09:00 / -05:30 / Z)。
# 「今日 / 昨日」の判定と GitHub 活動の日付の区切りに使う。既定 +09:00
#IHEALTH_TZ_OFFSET=+09:00
# 起動直後 (スリープ復帰直後など) にネットワーク接続を待つ最大秒数 (整数 0〜600)。
# この間に解消した接続エラーは失敗として通知しない。0 で待たない。既定 60
#IHEALTH_NETWORK_GRACE_SEC=60

# --- 気象庁 (天気) ---
# 観測所の府県番号 / 地点番号。既定は東京 (44 / 47662)。
# 気象庁「過去の気象データ検索」で地点を選んで「1時間ごとの値」を表示し、その URL
# (.../hourly_s1.php?prec_no=XX&block_no=XXXXX&...) から 2 つの番号を写す。
# 気象台・測候所 (URL が hourly_s1.php の地点) だけ対応。アメダス地点 (hourly_a1.php) は不可。
#JMA_PREC_NO=44
#JMA_BLOCK_NO=47662

# --- GitHub 活動 ---
# 未設定なら GitHub CLI のログイン (`gh auth token`) を使う。
# private repo / 所属 org の repo を数えるには、それらを読める token が必要
# (classic PAT なら repo + read:org。`gh auth login` の既定 scope で足りる)。
# token の値はログ・通知・実行レポートに出さない。
#GITHUB_TOKEN=
# 対象 owner (user / org の login) をカンマ区切りで絞る。既定: 自分 + 所属 org 全部
#GITHUB_OWNERS=your-name,your-org
# 対象から外す repo (owner/name をカンマ区切り)
#GITHUB_EXCLUDE_REPOS=your-name/dotfiles,your-org/sandbox

# =============================================================================
# その他の publisher (使う場合だけ。CLI 引数で指定してもよい)
# =============================================================================
# --publisher markdown の出力ディレクトリ (--markdown-out でも可)
#MARKDOWN_OUTPUT_DIR=~/notes/health
# --publisher sqlite の DB ファイル (--sqlite-path でも可)
#SQLITE_DB_PATH=~/health.db
# --publisher slack の Incoming Webhook URL (--slack-webhook でも可)
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<workspace-id>/<channel-id>/<secret>
